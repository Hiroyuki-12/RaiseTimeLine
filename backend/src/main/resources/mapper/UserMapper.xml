<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    UserMapper.xml: UserMapper インターフェースの各メソッドに対応する SQL を定義する。
    namespace に UserMapper の完全修飾クラス名を指定することで、インターフェースと紐づく。
    id には UserMapper のメソッド名を指定する。
-->
<mapper namespace="com.raisetimeline.user.UserMapper">

    <!--
        insert: users テーブルに1件 INSERT する。
        useGeneratedKeys="true" : DB が自動採番した id を取得する
        keyProperty="id"        : 取得した id を User.id フィールドにセットする
        #{フィールド名} は MyBatis のプレースホルダー。PreparedStatement で安全にバインドされる（SQL インジェクション対策）
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (email, password_hash, username, display_name, created_at, updated_at)
        VALUES (#{email}, #{passwordHash}, #{username}, #{displayName}, NOW(), NOW())
    </insert>

    <!--
        findByEmail: メールアドレスでユーザーを1件検索する。
        resultType に User クラスの完全修飾名を指定することで、SELECT 結果が User オブジェクトに自動マッピングされる。
        map-underscore-to-camel-case=true の設定により、password_hash → passwordHash のように自動変換される。
        Optional の場合、結果が0件なら MyBatis が Optional.empty() を返す。
    -->
    <select id="findByEmail" resultType="com.raisetimeline.user.User">
        SELECT *
        FROM users
        WHERE email = #{email}
    </select>

    <!--
        existsByEmail: 指定メールアドレスが存在するか確認する。
        EXISTS(...) は条件に一致する行が1件でもあれば true を返す。
        COUNT より効率的（1件見つかった時点で検索を止めるため）。
    -->
    <select id="existsByEmail" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM users WHERE email = #{email}
        )
    </select>

    <!--
        existsByUsername: 指定ユーザー名が存在するか確認する。
    -->
    <select id="existsByUsername" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM users WHERE username = #{username}
        )
    </select>

    <!--
        findById: ユーザー ID でユーザーを1件検索する。
        リフレッシュトークンには userId が記録されているため、
        アクセストークン再発行時にユーザー情報を取得するために使う。
    -->
    <select id="findById" resultType="com.raisetimeline.user.User">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <!--
        findByUsername: ユーザー名（@handle）でユーザーを1件検索する。
        プロフィールページは /users/:username という URL 構造なので
        username でユーザーを引く必要がある。
    -->
    <select id="findByUsername" resultType="com.raisetimeline.user.User">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <!--
        update: ユーザーのプロフィール情報を更新する。
        username, display_name, bio を更新対象とする。
        updated_at は常に現在時刻に更新する。
    -->
    <update id="update">
        UPDATE users
        SET username     = #{username},
            display_name = #{displayName},
            bio          = #{bio},
            updated_at   = NOW()
        WHERE id = #{id}
    </update>

    <!--
        findByUsernameContaining: キーワードでユーザー名を部分一致検索する（ユーザー検索画面用）。
        ILIKE は PostgreSQL 独自の大文字小文字を無視した LIKE 演算子。
        自分自身は結果から除外する（検索結果で自分をフォローするのは不自然なため）。
        isFollowing フラグは EXISTS サブクエリで1クエリで判定する（N+1 防止）。
        結果はユーザー名のアルファベット順で最大 20 件返す。
    -->
    <select id="findByUsernameContaining" resultType="com.raisetimeline.user.dto.UserSummary">
        SELECT
            u.id           AS id,
            u.username     AS username,
            u.display_name AS displayName,
            u.avatar_url   AS avatarUrl,
            (SELECT EXISTS(
                SELECT 1 FROM follows f
                WHERE f.follower_id = #{currentUserId} AND f.followee_id = u.id
            ))             AS isFollowing
        FROM users u
        WHERE u.username ILIKE CONCAT('%', #{q}, '%')
          AND u.id != #{currentUserId}
        ORDER BY u.username
        LIMIT 20
    </select>

    <!--
        updateAvatarUrl: ユーザーのアバター URL のみを更新する。
        プロフィール画像アップロード後に S3 の公開 URL を保存するために使う。
        updated_at も同時に更新して「最終更新日時」を正確に保つ。
    -->
    <update id="updateAvatarUrl">
        UPDATE users
        SET avatar_url = #{avatarUrl},
            updated_at = NOW()
        WHERE id = #{userId}
    </update>

    <!--
        existsByUsernameExcludingSelf: 自分以外に同じユーザー名が存在するか確認する。
        プロフィール編集時に「変更後のユーザー名が他のユーザーに使われていないか」を
        確認するために使う。自分が既に持っているユーザー名への更新は許可したいので
        自分の id を除外する。
    -->
    <select id="existsByUsernameExcludingSelf" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM users WHERE username = #{username} AND id != #{userId}
        )
    </select>

</mapper>
