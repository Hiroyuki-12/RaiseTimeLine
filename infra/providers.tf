# ==========================================================================
# AWS プロバイダ設定
# ==========================================================================
# このプロジェクトの主リージョンは東京（ap-northeast-1）。
# 認証情報はコードに書かず、~/.aws/credentials または環境変数から自動取得する
# （アクセスキーをコミットすると漏洩時に全リソースを操作されるため、絶対に書かない）。

provider "aws" {
  region = var.region

  # 全リソースに共通で付与するタグ。
  # コスト配分・棚卸し・誤削除防止のため「どのプロジェクト/環境/管理方法か」を必ず残す。
  default_tags {
    tags = {
      Project   = var.project
      Env       = var.env
      ManagedBy = "terraform"
    }
  }
}
