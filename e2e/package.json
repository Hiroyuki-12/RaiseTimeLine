{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "RaiseTimeLine の E2E（Playwright）テスト一式。シナリオテスト + ブラウザパフォーマンス計測。",
  "scripts": {
    "test": "playwright test",
    "test:scenario": "playwright test tests/auth.spec.ts tests/post.spec.ts tests/comment.spec.ts tests/social.spec.ts",
    "test:perf": "playwright test tests/perf.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report results/html-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.12.2",
    "axe-core": "^4.12.1",
    "typescript": "~6.0.2"
  }
}
